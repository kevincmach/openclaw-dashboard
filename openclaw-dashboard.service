[Unit]
Description=OpenClaw Agent Management Dashboard
After=network.target

[Service]
Type=simple
User=kevin
WorkingDirectory=/home/kevin/.openclaw/workspace/projects/openclaw-dashboard
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
