# OpenClaw Agent Management Dashboard — systemd service unit
#
# SETUP:
#   1. Edit WorkingDirectory and ExecStart to match your install path
#   2. Set User to the user that owns ~/.openclaw
#   3. Copy to /etc/systemd/system/openclaw-dashboard.service
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable --now openclaw-dashboard
#
# The EnvironmentFile line loads your .env config automatically.
# See .env.example for all available options.

[Unit]
Description=OpenClaw Agent Management Dashboard
Documentation=https://github.com/your-org/openclaw-dashboard
After=network.target

[Service]
Type=simple

# --- Change these to match your setup ---
User=kevin
WorkingDirectory=/home/kevin/.openclaw/workspace/projects/openclaw-dashboard
EnvironmentFile=-/home/kevin/.openclaw/workspace/projects/openclaw-dashboard/.env
ExecStart=/usr/bin/python3 app.py
# ----------------------------------------

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
