# ============================================================
# OpenClaw Dashboard — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All settings have sensible defaults for a standard ~/.openclaw
# installation — you only need to override what differs.

# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------

# Root of your OpenClaw data directory (default: ~/.openclaw)
# OPENCLAW_BASE_DIR=~/.openclaw

# Override individual paths only if you've customized your layout
# OPENCLAW_AGENTS_DIR=/custom/path/to/agents
# OPENCLAW_WORKSPACE_DIR=/custom/path/to/workspace
# OPENCLAW_CONFIG_PATH=/custom/path/to/openclaw.json

# ------------------------------------------------------------
# Auth & Tokens
# ------------------------------------------------------------

# Gateway token for agent notifications via the Kanban "Notify Agent" button.
# Find your token in openclaw.json or run: openclaw gateway status
# Leave blank to disable the Notify Agent feature.
OPENCLAW_GATEWAY_TOKEN=

# OpenRouter API key (optional).
# The dashboard will auto-discover this from your agent auth-profiles.json
# if not set here. Only needed if you want an explicit override.
# OPENCLAW_OPENROUTER_API_KEY=sk-or-v1-...

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

# Port to listen on (default: 5050)
# DASHBOARD_PORT=5050

# Host to bind to (default: 0.0.0.0 — all interfaces)
# DASHBOARD_HOST=0.0.0.0

# Flask secret key — change this in production
# DASHBOARD_SECRET_KEY=change-me-in-production

# ------------------------------------------------------------
# Advanced
# ------------------------------------------------------------

# Path to the openclaw binary (auto-detected from PATH by default)
# OPENCLAW_BIN=/usr/local/bin/openclaw
